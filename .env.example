# Supabase Config
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Places API Sync Config (Google Maps Business Reviews)
GOOGLE_PLACES_API_KEY=AIzaSy...
GOOGLE_PLACE_ID=ChIJ...

# Cloudflare Turnstile Antispam Config
# Site Key (pública, para el widget en el frontend)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Secret Key (privada, solo en Cloudflare Pages Environment Variables / Secrets)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# FormSubmit Target Email (privada, correo donde recibirás las propuestas)
FORMSUBMIT_TARGET_EMAIL=tu_correo@gmail.com

